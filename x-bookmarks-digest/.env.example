# --- X (Twitter) API v2 - OAuth 2.0 Authorization Code + PKCE ---
X_CLIENT_ID=your_x_oauth2_client_id
# Only set X_CLIENT_SECRET if your X app is a confidential client. For a
# Native/Public app with PKCE (recommended) leave this empty.
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8723/callback
# Optional. Auto-resolved via /2/users/me on first `auth` and cached in the token.
X_USER_ID=

# --- Token store ---
# file           -> state/token.json on local disk (good for dev / local cron)
# repo_encrypted -> state/token.enc committed to the repo (for Claude Routine /
#                   any ephemeral runner). Requires TOKEN_ENC_KEY.
TOKEN_STORE=file
# A Fernet key (44-char base64). Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this STATIC and store it as a durable environment variable (e.g. in the
# Claude environment config), NOT in the repo.
TOKEN_ENC_KEY=

# --- Notifiers (enable the ones listed in config.yaml -> notify.channels) ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
